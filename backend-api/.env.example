# Backend API Bridge Environment Configuration

# Application Port
PORT=3000
NODE_ENV=development

# Python Parser Microservice URL
PARSER_SERVICE_URL=http://127.0.0.1:8000/parse-pdf

# PostgreSQL Database Configuration (with pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_ai_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=legal_ai_db

# Redis Configuration (for BullMQ job processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Enable Mock In-Memory Database Mode for Testing without Live Postgres
USE_MOCK_DB=false

# Optional evidence-grounded answer generation. Keep this server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
